# Supply Chain Scanner – API Keys
# Copy this file to .env and fill in your values.
# The .env file is auto-loaded at startup and should NOT be committed to git.

# NVD API key – increases rate limit from 5 to 50 requests / 30 seconds.
# Register free at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# GitHub personal access token – enables GitHub Security Advisory (GHSA) queries.
# Create one at https://github.com/settings/tokens (no special scopes needed).
GITHUB_TOKEN=

# Sonatype Guide — adds another vulnerability source (successor to OSS Index).
# Get a free token at https://guide.sonatype.com/settings/tokens
SONATYPE_TOKEN=
